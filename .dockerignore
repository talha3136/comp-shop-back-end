# Ignore virtual environment
venv/

# Ignore database files
*.sqlite3
*.db

# Ignore media files (they'll be mounted as volumes)
media/

# Ignore static files (they'll be collected during build)
staticfiles/

# Ignore git directory
.git/

# Ignore environment files
.env
.env.*

# Ignore IDE files
.vscode/
.idea/

# Ignore Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore logs
logs/
*.log

# Ignore coverage files
.coverage
*.cover

# Ignore test files
test/
tests/

# Ignore documentation
API_DOCUMENTATION.md
